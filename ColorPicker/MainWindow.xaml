<Window x:Class="ColorPicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ColorPicker"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        x:Name="mainWindow"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Title="ColorPicker" Height="200" Width="280" MinHeight="200" MinWidth="280">

    <Window.Resources>
        <local:MultiColorStringToBrushConverter x:Key="multiColorStringToBrushConverter"/>
    </Window.Resources>
    
    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <RadioButton Content="Enable" x:Name="enableRadio"/>
            <RadioButton Content="Disable" Margin="10,0,0,0" x:Name="disableRadio"/>
        </StackPanel>
        
        <Line Grid.Row="1" X1="0" Y1="0" X2="{Binding ElementName=mainWindow,Path=ActualWidth}" Y2="0" Stroke="Black"/>

        <Grid Grid.Row="2" x:Name="colorConfigrationGrid" ShowGridLines="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="A:" VerticalAlignment="Center"/>
            <TextBlock Text="R:" VerticalAlignment="Center" Grid.Row="1"/>
            <TextBlock Text="G:" VerticalAlignment="Center" Grid.Row="2"/>
            <TextBlock Text="B:" VerticalAlignment="Center" Grid.Row="3"/>
            <TextBlock Text="Color:" VerticalAlignment="Center" Grid.Row="4"/>

            <TextBox x:Name="ATxb" Grid.Column="1" Margin="2,5" TextChanged="Txb_TextChanged" LostFocus="Txb_LostFocus" VerticalContentAlignment="Center" IsEnabled="{Binding ElementName=disableRadio,Path=IsChecked}">
                <TextBox.ContextMenu>
                    <ContextMenu Visibility="Collapsed" />
                </TextBox.ContextMenu>
            </TextBox>
            <TextBox x:Name="RTxb" Grid.Column="1" Margin="2,5" TextChanged="Txb_TextChanged" LostFocus="Txb_LostFocus" Grid.Row="1" VerticalContentAlignment="Center" IsEnabled="{Binding ElementName=disableRadio,Path=IsChecked}">
                <TextBox.ContextMenu>
                    <ContextMenu Visibility="Collapsed" />
                </TextBox.ContextMenu>
            </TextBox>
            <TextBox x:Name="GTxb" Grid.Column="1" Margin="2,5" TextChanged="Txb_TextChanged" LostFocus="Txb_LostFocus" Grid.Row="2" VerticalContentAlignment="Center" IsEnabled="{Binding ElementName=disableRadio,Path=IsChecked}">
                <TextBox.ContextMenu>
                    <ContextMenu Visibility="Collapsed" />
                </TextBox.ContextMenu>
            </TextBox>
            <TextBox x:Name="BTxb" Grid.Column="1" Margin="2,5" TextChanged="Txb_TextChanged" LostFocus="Txb_LostFocus" Grid.Row="3" VerticalContentAlignment="Center" IsEnabled="{Binding ElementName=disableRadio,Path=IsChecked}">
                <TextBox.ContextMenu>
                    <ContextMenu Visibility="Collapsed" />
                </TextBox.ContextMenu>
            </TextBox>
            <TextBox x:Name="ColorTxb" Grid.Column="1" Margin="2,5" KeyDown="ColorTxb_KeyDown" LostFocus="ColorTxb_LostFocus" Grid.Row="4" VerticalContentAlignment="Center" IsEnabled="{Binding ElementName=disableRadio,Path=IsChecked}">
                <TextBox.ContextMenu>
                    <ContextMenu Visibility="Collapsed" />
                </TextBox.ContextMenu>
            </TextBox>

            <Line Grid.Column="2" X1="0" Y1="0" X2="0" Y2="{Binding ElementName=colorConfigrationGrid,Path=ActualHeight}" Grid.RowSpan="5" Stroke="Black"/>
            <Border Grid.Column="3" Margin="5" Grid.RowSpan="5">
                <Border.Background>
                    <MultiBinding Converter="{StaticResource multiColorStringToBrushConverter}">
                        <Binding ElementName="ATxb" Path="Text"/>
                        <Binding ElementName="RTxb" Path="Text"/>
                        <Binding ElementName="GTxb" Path="Text"/>
                        <Binding ElementName="BTxb" Path="Text"/>
                    </MultiBinding>
                </Border.Background>
            </Border>

            
        </Grid>
    </Grid>
</Window>
